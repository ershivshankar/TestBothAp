<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Control" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#2979FF</item>
        <item name="colorPrimaryVariant">#1565C0</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#00CC44</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSurface">#1A1A1A</item>
        <item name="colorOnSurface">#EEEEEE</item>
        <item name="android:colorBackground">#121212</item>
        <item name="colorOnBackground">#EEEEEE</item>
        <item name="android:windowBackground">#121212</item>
        <item name="android:statusBarColor">#0D0D0D</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="materialAlertDialogTheme">@style/Theme.Control.Dialog</item>
    </style>

    <style name="Theme.Control.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">#1E1E1E</item>
        <item name="colorOnSurface">#EEEEEE</item>
        <item name="colorPrimary">#2979FF</item>
        <item name="android:textColorPrimary">#EEEEEE</item>
        <item name="android:textColorSecondary">#AAAAAA</item>
    </style>

    <style name="Theme.Control.BottomSheet" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="bottomSheetStyle">@style/Widget.Control.BottomSheet</item>
    </style>

    <style name="Widget.Control.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">#1A1A1A</item>
    </style>

</resources>
